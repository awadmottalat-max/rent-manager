{
  "name": "rent-manager",
  "version": "1.34.0",
  "description": "متابعة الإيجارات وإدارة الأملاك",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/test.js",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "author": "Rent Manager",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "electron-updater": "^6.8.11",
    "exceljs": "^4.4.0",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "sa.kathib.rentmanager",
    "productName": "متابعة الإيجارات",
    "files": [
      "main.js",
      "preload.js",
      "cloud.js",
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ]
    },
    "executableName": "RentManager",
    "publish": [
      {
        "provider": "github",
        "owner": "awadmottalat-max",
        "repo": "rent-manager"
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Rent-Manager-Setup-${version}.${ext}"
    }
  }
}